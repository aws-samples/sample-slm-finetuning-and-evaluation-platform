# Python
backend/.venv/
__pycache__/
*.pyc

# Node
frontend/node_modules/
frontend/dist/

# App LocalStore state — persisted splits/races/judge + config (runtime, not source)
backend/data/

# Local scratch space: working notes and generated datasets that are not part of
# the platform. Kept on disk, never committed.
local_folder*
local_files/

# agentcore CLI state (like tfstate: per-account ids + role/memory ARNs are baked
# in, so it must not be committed) and its local build cache. The runtime is
# CDK-managed — see infra/slm_platform_infra/stack.py.
agent/.bedrock_agentcore.yaml
agent/.bedrock_agentcore/

# Editor/agent project settings — machine-specific absolute paths.
.claude/settings.json

# TypeScript incremental build cache — regenerated by every `tsc -b`.
frontend/tsconfig.tsbuildinfo

# Environment files — never commit credentials or account-specific config.
.env
.env.*
!.env.example
